{
  "name": "inkstone-annotations",
  "version": "0.1.0",
  "description": "Text annotations and snapshot markup for mutable Markdown in Obsidian.",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs production && npm run check:mobile && npm run check:retired-document-ink",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:performance && npm run build",
    "check:mobile": "node scripts/check-mobile-bundle.mjs",
    "check:retired-document-ink": "node scripts/check-retired-document-ink.mjs",
    "check:vault-catalog-bounds": "node scripts/check-vault-catalog-bounds.mjs",
    "dev": "node esbuild.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:dev": "node scripts/install-dev.mjs",
    "gate:vault-catalog-local": "node scripts/gate-vault-catalog-local.mjs",
    "lint": "eslint .",
    "package:rc": "npm run check && node scripts/package-release.mjs && node scripts/verify-release-lifecycle.mjs",
    "prototype:s01": "node scripts/serve-prototype.mjs prototypes/s01-ui",
    "test": "vitest run --exclude 'src/**/*.gate.test.ts'",
    "test:coverage": "vitest run --coverage --exclude 'src/**/*.performance.test.ts' --exclude 'src/**/*.gate.test.ts'",
    "test:performance": "vitest run performance --coverage=false --maxWorkers=1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:rc-lifecycle": "node scripts/verify-release-lifecycle.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@preact/signals": "^2.9.3",
    "dexie": "4.4.4",
    "html-to-image": "1.11.13",
    "mdast-util-from-markdown": "2.0.3",
    "preact": "^10.29.7"
  }
}
