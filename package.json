{
  "name": "inkstone-annotations",
  "version": "0.1.3",
  "description": "Highlight and underline mutable Markdown, add notes, and draw on stable snapshots.",
  "author": "Ivan",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run typecheck:obsidian-1.7.2 && node esbuild.config.mjs production && npm run check:production-bundle && npm run check:mobile && npm run check:retired-document-ink",
    "build:web-hat": "npm run typecheck && npm run typecheck:obsidian-1.7.2 && node esbuild.config.mjs web-hat && npm run check:mobile && npm run check:retired-document-ink",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:i18n && npm run test:coverage && npm run test:performance && npm run build",
    "check:i18n": "vitest run src/ui/i18n src/adapters/obsidian/obsidian-locale.test.ts --coverage=false",
    "check:mobile": "node scripts/check-mobile-bundle.mjs",
    "check:production-bundle": "node scripts/check-production-bundle.mjs",
    "check:retired-document-ink": "node scripts/check-retired-document-ink.mjs",
    "check:vault-catalog-bounds": "node scripts/check-vault-catalog-bounds.mjs",
    "dev": "node esbuild.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:dev": "node scripts/install-dev.mjs",
    "gate:vault-catalog-local": "node scripts/gate-vault-catalog-local.mjs",
    "lint": "eslint .",
    "package:rc": "npm run check && node scripts/package-release.mjs && node scripts/verify-release-lifecycle.mjs",
    "prototype:s01": "node scripts/serve-prototype.mjs prototypes/s01-ui",
    "test": "vitest run --exclude 'src/**/*.gate.test.ts'",
    "test:coverage": "vitest run --coverage --exclude 'src/**/*.performance.test.ts' --exclude 'src/**/*.gate.test.ts'",
    "test:performance": "vitest run performance --coverage=false --maxWorkers=1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:obsidian-1.7.2": "tsc --noEmit -p tsconfig.obsidian-1.7.2.json",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:rc-lifecycle": "node scripts/verify-release-lifecycle.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "obsidian": "^1.13.1",
    "obsidian-1-7-2": "npm:obsidian@1.7.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@preact/signals": "^2.10.0",
    "decode-named-character-reference": "1.3.0",
    "dexie": "4.4.4",
    "html-to-image": "1.11.13",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "^3.1.0",
    "preact": "^10.29.7"
  }
}
